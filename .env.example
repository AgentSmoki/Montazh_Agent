# ============ TeleTranscribe (обязательно) ============
# Транскрипция через мой собственный TeleTranscribe stack (GigaAM + диаризация).
# MCP-сервер крутится через ~/Documents/Razarabotka/TeleTranscribe/services/telegram-bot/mcp_server.py
# Backend API доступен на localhost:8000 (или укажи production URL).
TT_API_KEY=tt_xxxxxxxxxxxxxxxx
TT_API_BASE_URL=http://localhost:8000

# ============ Генерация B-roll / image (опционально) ============
# Higgsfield — единый gateway к Veo 3.1 / Kling 3.0 / Hailuo 02 / Nano Banana Pro / Flux 2.
# OAuth через https://higgsfield.ai/mcp, 150 free credits/мес.
# Если используется HTTP-MCP, ключ не нужен — авторизация в Claude Code.
HIGGSFIELD_API_KEY=

# Fal.ai — 1000+ моделей одной точкой (опционально, если хочется альтернативу Higgsfield).
FAL_KEY=

# ============ TTS / музыка (опционально, для generative-only mode) ============
# Нужно только если используешь TTS-озвучку (когда нет своего голосового исходника).
ELEVENLABS_API_KEY=

# Suno для фоновой музыки.
SUNO_API_KEY=

# ============ Anthropic (не обязательно — Claude Code сам разруливает) ============
# Только если ты вызываешь Claude API из helper-скриптов напрямую (мы не вызываем).
ANTHROPIC_API_KEY=
