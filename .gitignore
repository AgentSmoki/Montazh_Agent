# test_sessions/ — рабочая директория для тестовых монтажей.
# Коммитятся только README.md и scenario_template.md, остальное локально.
test_sessions/*
!test_sessions/README.md
!test_sessions/scenario_template.md

# videos_dir/ — личные монтажи пользователя (реальное видео клиентов/проектов).
# Это рабочая песочница скилла; в репозиторий не попадает.
videos_dir/

# graphify — регенерируемое локальное состояние графа (не в общий репо)
graphify-out/

# Личные медиа (исходники / смонтированные ролики), случайно положенные в корень репо
